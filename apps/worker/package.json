{
  "name": "worker",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "wrangler dev --local",
    "build": "wrangler deploy --dry-run",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply ppm-dev --local",
    "db:migrate:prod": "wrangler d1 migrations apply ppm-production"
  },
  "dependencies": {
    "drizzle-orm": "^0.36.0",
    "hono": "^4.6.3",
    "jose": "^5.9.6",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "drizzle-kit": "^0.28.0",
    "typescript": "^5.6.3",
    "wrangler": "^3.83.0"
  }
}
